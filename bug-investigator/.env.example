# Copy to .env and fill in. Never commit .env.
DATABASE_URL=mysql+pymysql://bugi:bugi@localhost:3306/bug_investigator
GITHUB_TOKEN=

LLM_PROVIDER=gemini           # gemini | anthropic | openai | ollama
LLM_MODEL=gemini-2.5-flash    # check Google AI Studio for the current Flash model name
GOOGLE_API_KEY=               # free key from https://aistudio.google.com/apikey

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DATA_DIR=./data

MAX_ITERATIONS=3
TOKEN_BUDGET=200000
